# Only for `npm run dev`. A release build ignores these and finds its backend
# from its own script URL (it is served by the backend at /widget/rhinonbot.js).
REACT_APP_NEW_SERVER_API_URL=http://localhost:5055/widget
REACT_APP_API_URL_AI=http://localhost:5055/widget
REACT_APP_SOCKET_URL=http://localhost:5055
