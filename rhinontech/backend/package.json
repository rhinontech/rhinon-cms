{
  "name": "rhinontech-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "rm -rf dist && tsc && mkdir -p dist/assets && cp src/assets/*.png dist/assets/",
    "start": "node dist/server.js",
    "db:migrate": "ts-node src/config/migrate.ts",
    "db:seed": "ts-node src/config/seed.ts",
    "db:seed:work": "ts-node src/config/seed_work.ts",
    "db:seed:comms": "ts-node src/config/seed_comms.ts",
    "db:seed:letters": "ts-node src/config/seedLetterTemplates.ts",
    "db:backfill:letters": "ts-node src/config/backfillLetterContentBlocks.ts",
    "db:seed:leadership-template": "ts-node src/config/seedLeadershipTemplate.ts",
    "grant:crm": "ts-node src/config/grantCrm.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1043.0",
    "@aws-sdk/client-sesv2": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1043.0",
    "@google/generative-ai": "^0.24.1",
    "@googleapis/calendar": "^16.0.0",
    "@googleapis/oauth2": "^6.0.0",
    "axios": "^1.16.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ics": "^3.12.0",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.8",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.19.1",
    "pg": "^8.11.5",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.12.12",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.17.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
